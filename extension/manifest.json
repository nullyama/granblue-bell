{
  "manifest_version": 3,
  "name": "グラブル 戦闘終了ベル",
  "version": "1.0.8",
  "minimum_chrome_version": "116",
  "description": "グラブルの戦闘終了を音でお知らせ。",
  "permissions": [
    "storage",
    "offscreen",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/bell-16.png",
      "32": "icons/bell-32.png",
      "48": "icons/bell-48.png",
      "128": "icons/bell-128.png"
    }
  },
  "host_permissions": [
    "https://game.granbluefantasy.jp/*",
    "https://gbf.game.mbga.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://game.granbluefantasy.jp/*",
        "https://gbf.game.mbga.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/bell-16.png",
    "32": "icons/bell-32.png",
    "48": "icons/bell-48.png",
    "128": "icons/bell-128.png"
  }
}
